---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import Logo from './Logo.astro';
import { localeFromPath, localizePath } from '../nav.mjs';

const { sidebar } = Astro.locals.starlightRoute;
const locale = localeFromPath(Astro.url.pathname);
const t = Astro.locals.t;
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="sidebar-footer">
  <a href={localizePath('/', locale)} class="sidebar-footer-logo">
    <Logo variant="docs" size={22} />
  </a>
  <button class="sidebar-collapse-btn" aria-label={t('aptive.sidebar.collapse')} data-sidebar-toggle>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
</div>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<script is:inline>
  /* Two jobs for the sidebar's <details> section groups (and the mobile drawer's
     accordion sections, which are the same <details> shape):

     1. The group holding the current page is ALWAYS open on load. The server
        renders it open, but Starlight's SidebarPersister then restores every
        group's `open` from sessionStorage (`sl-sidebar-state`) as each
        `<sl-sidebar-restore>` connects — so a group the reader had collapsed on
        an earlier page came back collapsed around the page they were now on,
        hiding the current link. We run on DOMContentLoaded, after every restore
        point has connected, and re-open any group containing
        `[aria-current="page"]`. Other groups keep their restored state, so a
        reader's open/close of those still persists.

     2. Animate the fold open/closed with the grid-template-rows 0fr↔1fr trick
        instead of the native instant snap. We wrap each group's content (the
        sublist after <summary>) in a `.sl-collapse-anim` grid wrapper, then drive
        the fold ourselves:
          • opening: set <details open> first (so the content isn't UA-hidden),
            then flip the wrapper to data-open="true" → animates to 1fr.
          • closing: flip the wrapper to data-open="false" → animates to 0fr, and
            only set open=false once the transition ends (a timeout backstops it),
            so the content stays visible for the whole close.
        Native <details>/<summary> keyboard + a11y semantics are preserved — the
        summary's Enter/Space still fires the same click we intercept, and `open`
        ends up reflecting the real state. Under reduced motion we skip this and
        let the browser toggle natively (the CSS transition is neutralised anyway).

        The click handler is delegated to `document` on purpose: it must run
        AFTER Starlight's own recorder on `<sl-sidebar-state-persist>`, which
        stores `!details.open` at click time. A handler on the summary ran first
        and set `open = true` before the recorder looked, so every OPEN was
        stored as a close and never survived a reload. preventDefault() from the
        document still cancels the native toggle, which happens after dispatch. */
  (function() {
    var GROUPS = '.sidebar details, #starlight__sidebar details, #cc-mobile-drawer details';
    var reducedMotion = typeof matchMedia !== 'undefined'
      && matchMedia('(prefers-reduced-motion: reduce)').matches;

    function openCurrent(details) {
      if (details.querySelector('[aria-current="page"]')) details.open = true;
    }

    function enhance(details) {
      if (details.dataset.slCollapseReady) return;
      var summary = details.querySelector(':scope > summary');
      var content = details.querySelector(':scope > summary ~ *');
      if (!summary || !content) return;
      details.dataset.slCollapseReady = '1';

      var wrapper = document.createElement('div');
      wrapper.className = 'sl-collapse-anim';
      content.parentNode.insertBefore(wrapper, content);
      wrapper.appendChild(content);
      wrapper.dataset.open = String(details.open);
    }

    function onSummaryClick(e) {
      var summary = e.target.closest && e.target.closest('summary');
      var details = summary && summary.parentElement;
      if (!details || !details.dataset.slCollapseReady) return;
      if (details.querySelector(':scope > summary') !== summary) return;
      var wrapper = details.querySelector(':scope > .sl-collapse-anim');
      if (!wrapper) return;

      e.preventDefault();
      window.clearTimeout(details._slCloseTimer);
      if (details.open) {
        // Closing: collapse the grid, then drop `open` after the transition.
        wrapper.dataset.open = 'false';
        var done = function() {
          wrapper.removeEventListener('transitionend', onEnd);
          details.open = false;
        };
        var onEnd = function(ev) {
          if (ev.propertyName === 'grid-template-rows') done();
        };
        wrapper.addEventListener('transitionend', onEnd);
        details._slCloseTimer = window.setTimeout(done, 320);
      } else {
        // Opening: reveal the content collapsed (0fr), force a synchronous
        // reflow so the browser commits that frame, then expand to 1fr — this
        // triggers the transition without relying on requestAnimationFrame
        // (which is paused while the tab is backgrounded).
        details.open = true;
        wrapper.dataset.open = 'false';
        void wrapper.offsetHeight;
        wrapper.dataset.open = 'true';
      }
    }

    function init() {
      var groups = document.querySelectorAll(GROUPS);
      // Open the current page's group BEFORE enhance() reads `open` into the
      // wrapper, so the wrapper's data-open agrees with it.
      groups.forEach(openCurrent);
      if (reducedMotion) return;
      groups.forEach(enhance);
      document.addEventListener('click', onSummaryClick);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
