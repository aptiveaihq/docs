---
/**
 * "Ask me anything": opens AptiveAI Agents in a new tab with a question about
 * these docs (a named preset the product sends on arrival). The label, the
 * question and the product URL all come from src/ask.mjs, in the page's
 * language.
 *
 * Every variant wears `.agents-cta` (src/styles/custom.css), the portal's
 * animated "Open Agents" gradient: the same living gradient marks every link
 * from these docs into the product. Colour and motion come from that class,
 * so the scoped rules below set layout only — a scoped colour would outrank it.
 *
 *   variant="nav"    — first entry of the desktop header nav
 *   variant="drawer" — first row of the phone menu (MobileDrawer)
 *   variant="card"   — the landing page's lead card
 */
import { askFor, askHref } from '../ask.mjs';
import NavIcon from './NavIcon.astro';

interface Props {
  variant: 'nav' | 'drawer' | 'card';
}

const { variant } = Astro.props;
const lang = Astro.locals.starlightRoute?.lang ?? 'en';
const locale = lang.startsWith('es') ? 'es' : 'en';
const ask = askFor(locale);
const href = askHref(locale);
---

{variant === 'nav' && (
  <a href={href} target="_blank" rel="noopener noreferrer" class="header-nav-link ask-nav-link agents-cta" data-ask-link>
    <NavIcon name="sparkles" strokeWidth={1.75} />
    <span>{ask.label}</span>
    <span aria-hidden="true" class="agents-cta-arrow">↗</span>
  </a>
)}

{variant === 'drawer' && (
  <a href={href} target="_blank" rel="noopener noreferrer" class="bottom-nav-menu-item ask-drawer-link agents-cta" data-ask-link>
    <NavIcon name="sparkles" />
    <span class="bn-group-label">{ask.label}</span>
    <span aria-hidden="true" class="agents-cta-arrow">↗</span>
  </a>
)}

{variant === 'card' && (
  <div class="ask-card-wrap not-content">
  <a href={href} target="_blank" rel="noopener noreferrer" class="ask-card" data-ask-link>
    <span class="ask-card-icon"><NavIcon name="sparkles" strokeWidth={1.75} /></span>
    <span class="ask-card-text">
      <span class="ask-card-title">{ask.cardTitle}</span>
      <span class="ask-card-body">{ask.cardBody}</span>
    </span>
    <span class="ask-card-cta agents-cta">{ask.cardCta}<span aria-hidden="true" class="agents-cta-arrow">↗</span></span>
  </a>
  </div>
)}

<style>
  /* The header's own .header-nav-link rules are scoped to Header.astro and do
     not reach this component, so the typography is restated here. */
  .ask-nav-link {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    font-weight: 600;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 0.375rem;
  }
  .ask-nav-link:hover {
    text-decoration: none;
  }
  .ask-nav-link :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* A gradient pill inset from the drawer's edges, not a full-bleed row.
     The hover colour is restated because `.bottom-nav-menu-item:hover`
     (custom.css) outranks `.agents-cta` and would grey the label. */
  .ask-drawer-link {
    margin: 0.25rem 1rem 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-weight: 700;
  }
  .ask-drawer-link.agents-cta,
  .ask-drawer-link.agents-cta:hover {
    color: var(--cta-text);
    text-decoration: none;
  }

  /* Same column as the splash .card-grid below it (custom.css). */
  .ask-card-wrap {
    max-width: 864px;
    margin: 0 auto;
    padding: 0 1.5rem 1.5rem;
  }
  .ask-card {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text);
    text-decoration: none;
    transition: background-color 150ms ease, transform 150ms ease;
  }
  .ask-card:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
  }
  .ask-card:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #005fb8);
    outline-offset: 2px;
  }
  .ask-card-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--signup-text, #000);
  }
  .ask-card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .ask-card-text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .ask-card-title {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .ask-card-body {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
  .ask-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    font-size: var(--sl-text-sm);
    font-weight: 700;
    white-space: nowrap;
    padding: 0.4375rem 1rem;
    border-radius: 0.375rem;
  }
  @media (max-width: 40rem) {
    .ask-card {
      flex-wrap: wrap;
    }
    .ask-card-text {
      flex-basis: calc(100% - 3.5rem);
    }
    .ask-card-cta {
      margin-inline-start: 3.5rem;
    }
  }
</style>
